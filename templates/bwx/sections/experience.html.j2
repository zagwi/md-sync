<div class="section">
  <div class="section-title">{{ section.title }}</div>
  {% for item in section.items %}
  <div class="exp-item">
    <div class="exp-header">
      <span class="company">{{ item.title }}{% if item.subtitle %} <span class="role-tag">{{ item.subtitle }}</span>{% endif %}</span>
      <span class="period">{{ item.period }}</span>
    </div>
    {% if item.people %}
    <div class="exp-sub">{% if doc.source_lang == 'zh' %}下属{% endif %}{{ item.people }}{% if doc.source_lang == 'en' %} reports{% else %}人{% endif %}</div>
    {% endif %}
    <div class="exp-desc">{{ t(item.content) | replace_metrics | safe }}</div>
  </div>
  {% endfor %}
</div>
