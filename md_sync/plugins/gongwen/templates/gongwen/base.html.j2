<!DOCTYPE html>
<html lang="{{ doc.source_lang or 'zh' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ t(doc.name) }}{% if doc.title %} - {{ t(doc.title) }}{% endif %}</title>
<style>
{{ style_css }}
{% if print_css %}
@media print {
{{ print_css }}
}
{% endif %}
</style>
</head>
<body>

<div id="write">
{% if body_html %}
{% set _content = body_html %}
{% else %}
{% set _content %}
{% if doc.title or doc.name %}
<h1 class="gongwen-title">{{ t(doc.title or doc.name) }}</h1>
{% endif %}

{% for section in doc.sections %}
  {% if section.title %}<h{{ section.level }}>{{ t(section.title) }}</h{{ section.level }}>{% endif %}
  {% for item in section.items %}
    {% if item.type == "bullet" %}
    <ul>
      <li>{{ t(item.content) | md_inline | linkify | safe }}</li>
    </ul>
    {% elif item.type == "text" %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% elif item.type == "code" %}
    <pre{% if item.language %} class="language-{{ item.language }}"{% endif %}><code>{{ item.content | e }}</code></pre>
    {% elif item.type == "table" %}
    <table>
    {% set rows = item.content.split(chr(10)) %}
    {% set _sep = namespace(found=false) %}
    {% for row in rows %}
      {%- set _body = row.strip("|") %}
      {%- set _cleaned = _body | replace("|", "") | replace("-", "") | replace(":", "") | replace(" ", "") %}
      {%- if _cleaned == "" and "-" in _body %}
        {% set _sep.found = true %}
      {%- else %}
        {%- set cells = _body.split("|") %}
        {%- if not _sep.found %}
        <thead><tr>
        {%- for cell in cells %}
        <th>{{ t(cell.strip()) | md_inline | linkify | safe }}</th>
        {%- endfor %}
        </tr></thead><tbody>
        {%- else %}
        <tr>
        {%- for cell in cells %}
        <td>{{ t(cell.strip()) | md_inline | linkify | safe }}</td>
        {%- endfor %}
        </tr>
        {%- endif %}
      {%- endif %}
    {%- endfor %}
    </tbody></table>
    {% elif item.type == "hr" %}
    <hr>
    {% elif item.type == "md" %}
    <div class="md-block">{{ t(item.content) | md_block | safe }}</div>
    {% else %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% endif %}
  {% endfor %}
{% endfor %}
{% endset %}
{% endif %}
{% if 'gongwen_chrome' in environment.filters %}
{{ _content | gongwen_chrome | safe }}
{% else %}
{{ _content | safe }}
{% endif %}
</div>

</body>
</html>
