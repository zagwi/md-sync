<div class="section">
  <div class="section-title">{{ section.title }}</div>
  {% for item in section.items %}
  <div class="edu-item">
    <span class="school">{{ item.title }}{% if item.subtitle and '.' in item.subtitle %} <span class="tag">{{ item.subtitle.split('.')[0].strip() }}</span>{% endif %}</span>
    <span>{{ item.subtitle if item.subtitle else '' }}</span>
    <span class="period">{{ item.period }}</span>
  </div>
  {% endfor %}
</div>
