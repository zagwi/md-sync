<!DOCTYPE html>
<html lang="{{ doc.source_lang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ doc.name }} - {{ doc.title }}</title>
<style>
{{ style_css }}
{% if print_css %}
@media print {
{{ print_css }}
}
{% endif %}

{% if typora_css %}
/* === md-sync × Typora 主题兼容修正 ===
   兼容两套命名:现代主题(bloom 系)用 --bg / --text / --code-bg,
   传统主题(night 等)用 --bg-color / --text-color。md-sync 生成的
   <pre> 不带 Typora 的 .md-fences 类,代码块样式需在此补齐;标题/正文
   颜色用变量回退链,确保 dark 主题(无 --bg)不会被 fallback 成深色字或浅色底。 */
/* 标题与正文颜色:回退到传统 --text-color,避免 dark 主题 fallback 成深灰字 */
#write {
  color: var(--text, var(--text-color, #1a1a1a));
}
#write h1, #write h2, #write h3, #write h4, #write h5, #write h6 {
  color: var(--text, var(--text-color, #1a1a1a));
}
/* 代码块:md-sync 的 <pre> 不带 Typora 的 .md-fences 类,主题 pre 规则失效,补通用样式。
   变量回退链兼容三套命名:bloom 系(--code-bg/--accent-rgb)、
   传统 dark 主题(night: --bg-color/--text-color)、claude 系(--code-bg-color/
   --code-text-color/--code-border-color/--accent-color),确保各主题代码块配色协调。 */
#write pre {
  background: var(--code-bg, var(--code-bg-color, var(--bg-color, #f5f5f5)));
  color: var(--code-text, var(--code-text-color, var(--text-color, #333)));
  border: 1px solid var(--code-border-color, var(--accent-color, rgba(120, 120, 120, 0.18)));
  border-radius: 14px;
  padding: 1.2em 1.4em;
  overflow: auto;
  line-height: 1.6;
  font-family: var(--font-mono, monospace);
  font-size: 14.5px;
}
#write pre code {
  background: transparent;
  color: inherit;
  padding: 0;
  border: 0;
  font-weight: 400;
}
/* 仅现代主题(含 "--bg:" 变量,如 bloom 系)需要派生"底色 + 卡片"结构:
   主题里 #write 用 `background: 渐变`(shorthand 把 background-color 重置为
   transparent),故用 color-mix 基于 --bg 派生实色底并保留原有渐变 image。
   传统主题(night 用 --bg-color 而非 --bg)直接沿用原生深色 body/#write,
   不强行覆盖,否则会把 dark 主题洗成 light。 */
{% if '--bg:' in typora_css %}
html, body {
  background: color-mix(in srgb, var(--bg, #ffffff), black 10%) !important;
}
#write {
  background-color: color-mix(in srgb, var(--bg, #ffffff), white 12%);
}
{% elif typora_dark %}
/* dark 主题：部分主题(compact-night 等)只通过 Typora 专属选择器
   (body.typora-export / content)设置背景，导出 HTML 没有这些类导致
   白底。pipeline 已判定为 dark，这里把主题背景色补到 html/body。
   变量回退链：--bg-color(night/compact) → --bg(bloom) → --db-dk(vlook) */
html, body {
  background: var(--bg-color, var(--bg, var(--db-dk, #1b1b1b))) !important;
}
#write {
  background-color: transparent;
}
{% endif %}
/* 打印(PDF)时让 #write 铺满整页、去掉卡片圆角/阴影,并由 pdf.py 注入的
   print-color-adjust: exact 保证 html/body/#write 底色延伸到 @page 边缘,
   避免"白色边框 / 页边发白"的不专业观感。 */
@media print {
  html, body { margin: 0 !important; }
  #write {
    max-width: none !important;
    width: 100% !important;
    margin: 0 auto !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    border: 0 !important;
  }
}
{% endif %}
/* 表格拉满宽度。边框/表头底色由 pipeline 检测的主题明暗决定(typora_dark)，
   注入具体颜色而非 CSS 变量回退链——很多 dark 主题(ia_typora_night、
   vlook-*)既不定义 --text 也不定义 --text-color，变量回退链会落到深色
   #333 导致深底深框边框隐形。这里直接按明暗给两套确定颜色：
     dark:  边框 #4a5058(深底上清晰可见)，表头 12% 白(略亮的浅条)
     light: 边框 #ddd，表头 #f5f5f5(与 Typora 浅色主题原生观感一致) */
#write table { width: 100%; border-collapse: collapse; }
#write th, #write td { padding: 6px 10px; text-align: left; }
{% if typora_dark %}
#write th, #write td { border: 1px solid #4a5058; }
#write th { background: rgba(255, 255, 255, 0.12); font-weight: 700; }
{% else %}
#write th, #write td { border: 1px solid #ddd; }
#write th { background: #f5f5f5; font-weight: 700; }
{% endif %}
@media print {
  #write table { width: 100%; border-collapse: collapse; }
  #write th, #write td { padding: 4px 8px; text-align: left; }
{% if typora_dark %}
  #write th, #write td { border: 1px solid #4a5058; }
  #write th { background: rgba(255, 255, 255, 0.12); font-weight: 700; }
{% else %}
  #write th, #write td { border: 1px solid #ccc; }
  #write th { background: #f0f0f0; font-weight: 700; }
{% endif %}
  /* 允许代码块在页间自然断开，避免大块空白 */
  pre { page-break-inside: auto; break-inside: auto; }
  code { word-wrap: break-word; white-space: pre-wrap; }
}
</style>
</head>
<body>

<div id="write">
{% if body_html %}
{{ body_html | safe }}
{% else %}
<h1>{{ doc.name }}</h1>

{% for section in doc.sections %}
  {% if section.title %}<h{{ section.level + 1 if section.level else 2 }}>{{ section.title }}</h{{ section.level + 1 if section.level else 2 }}>{% endif %}
  {% for item in section.items %}
    {% if item.type == "bullet" %}
    <ul>
      <li>{{ t(item.content) | md_inline | linkify | safe }}</li>
    </ul>
    {% elif item.type == "text" %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% elif item.type == "code" %}
    <pre{% if item.language %} class="language-{{ item.language }}"{% endif %}><code>{{ item.content | e }}</code></pre>
    {% elif item.type == "table" %}
    <table>
    {% set rows = item.content.split(chr(10)) %}
    {% set _sep = namespace(found=false) %}
    {% for row in rows %}
      {%- if row.startswith("|---") or row.startswith("|:--") %}
        {% set _sep.found = true %}
      {%- else %}
        {%- set cells = row.strip("|").split("|") %}
        {%- if not _sep.found %}
        <thead><tr>
        {%- for cell in cells %}
        <th>{{ t(cell.strip()) | md_inline | linkify | safe }}</th>
        {%- endfor %}
        </tr></thead><tbody>
        {%- else %}
        <tr>
        {%- for cell in cells %}
        <td>{{ t(cell.strip()) | md_inline | linkify | safe }}</td>
        {%- endfor %}
        </tr>
        {%- endif %}
      {%- endif %}
    {%- endfor %}
    </tbody></table>
    {% elif item.type == "hr" %}
    <hr>
    {% elif item.type == "md" %}
    <div class="md-block">{{ t(item.content) | md_block | safe }}</div>
    {% elif item.type == "entry" %}
    <p><strong>{{ item.title }}</strong>{% if item.subtitle %} — {{ item.subtitle }}{% endif %}{% if item.period %} ({{ item.period }}){% endif %}</p>
    {% if item.content %}<p>{{ t(item.content) | md_inline | linkify | safe }}</p>{% endif %}
    {% elif item.type == "project" %}
    <p><strong>{{ item.title }}</strong>{% if item.role %} — {{ item.role }}{% endif %}</p>
    {% if item.content %}<p>{{ t(item.content) | md_inline | linkify | safe }}</p>{% endif %}
    {% else %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% endif %}
  {% endfor %}
{% endfor %}
{% endif %}
</div>

</body>
</html>
