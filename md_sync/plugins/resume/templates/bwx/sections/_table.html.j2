{# Shared table rendering for any section template #}
{# Expects: item (Item with type="table"), t (translation function), chr, markdown_filters #}
<table>
{% set rows = item.content.split(chr(10)) %}
{% set _sep = namespace(found=false) %}
{% for row in rows %}
  {%- if row.startswith("|---") or row.startswith("|:--") %}
    {% set _sep.found = true %}
  {%- else %}
    {%- set cells = row.strip("|").split("|") %}
    {%- if not _sep.found %}
    <thead><tr>
    {%- for cell in cells %}
    <th>{{ t(cell.strip()) | rich | safe }}</th>
    {%- endfor %}
    </tr></thead><tbody>
    {%- else %}
    <tr>
    {%- for cell in cells %}
    <td>{{ t(cell.strip()) | rich | safe }}</td>
    {%- endfor %}
    </tr>
    {%- endif %}
  {%- endif %}
{%- endfor %}
</tbody></table>
