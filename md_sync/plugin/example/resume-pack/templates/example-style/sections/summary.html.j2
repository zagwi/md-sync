<div class="section">
  <h2 class="section-title">{{ section.title }}{% if section.badge %} <span class="badge">{{ section.badge }}</span>{% endif %}</h2>
  <ul class="summary-list">
    {% for item in section.items %}
    <li>{{ t(item.content) | linkify | replace_metrics | safe }}</li>
    {% endfor %}
  </ul>
</div>
