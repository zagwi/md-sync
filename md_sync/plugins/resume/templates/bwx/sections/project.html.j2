<div class="section">
  <div class="section-title">{{ section.title }}</div>
  {% for item in section.items %}
  {% if item.type == "table" %}
  {% include '_table.html.j2' %}
  {% elif item.type == "code" %}
  {% include '_code.html.j2' %}
  {% else %}
  <div class="proj-item">
    <div class="proj-header">
      <span class="proj-title">{{ item.title }}</span>
      {% if item.role %}<span class="role-tag">{{ item.role }}</span>{% endif %}
      <span class="period">{{ item.period }}</span>
    </div>
    <div class="proj-desc">{{ t(item.content) | rich | safe }}</div>
    {% if item.tags %}
    <div class="proj-tech">{% if doc.source_lang == 'zh' %}涉及技术：{% else %}Tech Stack: {% endif %}{{ item.tags | join(', ') }}</div>
    {% endif %}
  </div>
  {% endif %}
  {% endfor %}
</div>
