<div class="section">
  <h2 class="section-title">{{ section.title }}</h2>
  {% for item in section.items %}
  <div class="entry">
    <div class="entry-header">
      <span class="entry-title">{{ item.title }}</span>
      {% if item.url %} - <a class="ext-link" href="{{ item.url }}" target="_blank">{{ item.url }}</a>{% endif %}
    </div>
    {% if item.content %}
    <div class="entry-content">{{ t(item.content) | linkify | replace_metrics | safe }}</div>
    {% endif %}
    {% if item.features %}
    <ul class="summary-list">
      {% for feat in item.features %}
      <li>{{ feat }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if item.tags %}
    <div class="tech-tags">
      {% for tag in item.tags %}<span class="tech-tag">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>
