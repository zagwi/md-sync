<div class="section">
  <h2 class="section-title">{{ section.title }}</h2>
  {% for item in section.items %}
    {% if item.type == "bullet" %}
    <div class="bullet-item">{{ t(item.content) | linkify | replace_metrics | safe }}</div>
    {% else %}
    <p>{{ t(item.content) | linkify | replace_metrics | safe }}</p>
    {% endif %}
  {% endfor %}
</div>
