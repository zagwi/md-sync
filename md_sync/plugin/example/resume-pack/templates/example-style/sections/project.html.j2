<div class="section">
  <h2 class="section-title">{{ section.title }}</h2>
  {% for item in section.items %}
  <div class="entry">
    <div class="project-header">
      <span class="entry-title">{{ item.title }}</span>
      {% if item.period %}<span class="project-period">{{ item.period }}</span>{% endif %}
      {% if item.role %}<span class="project-role"> · {{ item.role }}</span>{% endif %}
    </div>
    {% if item.content %}
    <div class="project-content">{{ t(item.content) | linkify | replace_metrics | safe }}</div>
    {% endif %}
    {% if item.tags %}
    <div class="tech-tags">
      {% for tag in item.tags %}<span class="tech-tag">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>
