<!DOCTYPE html>
<html lang="{{ doc.source_lang or 'en' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ doc.name }} - {{ doc.title }}</title>
<style>
{{ style_css }}
{% if print_css %}
@media print {
{{ print_css }}
}
{% endif %}
</style>
</head>
<body>

<div class="page">
  {% if not body_html %}
  <div class="header">
    <h1>{{ doc.name }}</h1>
    <div class="title-role">{{ doc.title }}</div>
    <div class="contact">
      {% for key, val in doc.contacts.items() %}
      <span>{{ val }}</span>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  <div class="body">
    {% if body_html %}
    {{ body_html | safe }}
    {% else %}
    {% for section in doc.sections %}
    {% set section_tpl = sections_meta.get(section.id, {}).get('template', 'sections/summary.html.j2') %}
    {% include 'sections/' + section_tpl.split('/')[-1] %}
    {% endfor %}
    {% endif %}
  </div>
</div>

</body>
</html>
