<!DOCTYPE html>
<html lang="{{ doc.source_lang or 'zh' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ doc.name }}{% if doc.title %} - {{ doc.title }}{% endif %}</title>
<style>
{{ style_css }}
{% if print_css %}
@media print {
{{ print_css }}
}
{% endif %}
</style>
</head>
<body>

<div id="write">
{% if body_html %}
{{ body_html | safe }}
{% else %}
<h1>{{ doc.name }}</h1>

{% for section in doc.sections %}
  {% if section.title %}<h{{ section.level + 1 if section.level else 2 }}>{{ section.title }}</h{{ section.level + 1 if section.level else 2 }}></h{{ section.level + 1 if section.level else 2 }}>{% endif %}
  {% for item in section.items %}
    {% if item.type == "bullet" %}
    <ul>
      <li>{{ t(item.content) | md_inline | linkify | safe }}</li>
    </ul>
    {% elif item.type == "text" %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% elif item.type == "code" %}
    <pre{% if item.language %} class="language-{{ item.language }}"{% endif %}><code>{{ item.content | e }}</code></pre>
    {% elif item.type == "table" %}
    <table>
    {% set rows = item.content.split(chr(10)) %}
    {% set _sep = namespace(found=false) %}
    {% for row in rows %}
      {%- if row.startswith("|---") or row.startswith("|:--") %}
        {% set _sep.found = true %}
      {%- else %}
        {%- set cells = row.strip("|").split("|") %}
        {%- if not _sep.found %}
        <thead><tr>
        {%- for cell in cells %}
        <th>{{ t(cell.strip()) | md_inline | linkify | safe }}</th>
        {%- endfor %}
        </tr></thead><tbody>
        {%- else %}
        <tr>
        {%- for cell in cells %}
        <td>{{ t(cell.strip()) | md_inline | linkify | safe }}</td>
        {%- endfor %}
        </tr>
        {%- endif %}
      {%- endif %}
    {%- endfor %}
    </tbody></table>
    {% elif item.type == "hr" %}
    <hr>
    {% elif item.type == "md" %}
    <div class="md-block">{{ t(item.content) | md_block | safe }}</div>
    {% else %}
    <p>{{ t(item.content) | md_inline | linkify | safe }}</p>
    {% endif %}
  {% endfor %}
{% endfor %}
{% endif %}
</div>

</body>
</html>
