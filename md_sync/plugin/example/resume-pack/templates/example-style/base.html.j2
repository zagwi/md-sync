<!DOCTYPE html>
<html lang="{{ lang or 'zh-CN' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ doc.name }} - {{ doc.title }}</title>
<style>
{{ style_css }}
{% if print_css %}@media print {
{{ print_css }}
}{% endif %}
</style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="resume-header">
      <h1 class="name">{{ doc.name }}</h1>
      {% if doc.title %}<p class="title">{{ doc.title }}</p>{% endif %}
      {% if doc.meta_lines %}
      <div class="contact-info">
        {% for line in doc.meta_lines %}
        <p>{{ line }}</p>
        {% endfor %}
      </div>
      {% endif %}
    </header>

    <!-- Sections -->
    {% for section in doc.sections %}
      {% set section_config = sections_meta.get(section.id, {}) %}
      {% set template_name = section_config.get('template', 'sections/' + section.id + '.html.j2') %}
      {% include template_name %}
    {% endfor %}
  </div>
</body>
</html>
